# Copy to .env; replace the API key and database credentials.
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=30

# Legacy single-database configuration (used when DATABASES is empty).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_MIN_POOL_SIZE=5
DATABASE_MAX_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30
DATABASE_COMMAND_TIMEOUT=30

# Multi-database mode: aliases need not equal PostgreSQL database names.
# DATABASES='{"analytics":{"host":"localhost","name":"reports","user":"reader","password":"replace"},"crm":{"host":"localhost","name":"customers","user":"reader","password":"replace"}}'
# Database-specific policies replace the global security section for that alias.
# Unspecified fields retain SecurityConfig defaults.
# DATABASE_SECURITY='{"crm":{"blocked_tables":["private.audit"],"blocked_columns":["users.password"],"allow_explain":false}}'

# Read-only mode is mandatory; setting this to true is a configuration error.
SECURITY_ALLOW_WRITE_OPERATIONS=false
SECURITY_BLOCKED_TABLES=[]
SECURITY_BLOCKED_COLUMNS=["password","password_hash","api_key"]
SECURITY_BLOCKED_FUNCTIONS=pg_sleep,pg_read_file,pg_write_file,lo_import,lo_export
SECURITY_ALLOW_EXPLAIN=false
SECURITY_SAFE_SEARCH_PATH=public
# SECURITY_READONLY_ROLE=reader
SECURITY_MAX_ROWS=10000
SECURITY_MAX_EXECUTION_TIME=30

VALIDATION_MAX_QUESTION_LENGTH=10000
VALIDATION_ENABLED=true
VALIDATION_SAMPLE_ROWS=5
VALIDATION_TIMEOUT_SECONDS=10
VALIDATION_MIN_CONFIDENCE_SCORE=70
VALIDATION_CONFIDENCE_THRESHOLD=70

CACHE_ENABLED=true
CACHE_SCHEMA_TTL=3600
CACHE_MAX_SIZE=100
CACHE_AUTO_REFRESH=false
CACHE_REFRESH_INTERVAL_MINUTES=60

RESILIENCE_MAX_RETRIES=3
RESILIENCE_RETRY_DELAY=1
RESILIENCE_BACKOFF_FACTOR=2
RESILIENCE_CIRCUIT_BREAKER_THRESHOLD=5
RESILIENCE_CIRCUIT_BREAKER_TIMEOUT=60
RESILIENCE_QUERY_LIMIT=10
RESILIENCE_LLM_LIMIT=5
RESILIENCE_ACQUIRE_TIMEOUT=1

OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_PORT=9090
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_LOG_FORMAT=json
ENVIRONMENT=development
